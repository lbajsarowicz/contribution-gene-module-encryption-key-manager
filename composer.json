{
    "name": "gene/module-encryption-key-manager",
    "description": "Gene encryption key manager",
    "type": "magento2-module",
    "license": "LGPL-3.0-only",
    "require": {
        "php": "^8.1||^8.2||^8.3|^8.4",
        "magento/module-jwt-user-token": "*",
        "magento/module-encryption-key": "*",
        "magento/module-catalog": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Gene\\EncryptionKeyManager\\": ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
